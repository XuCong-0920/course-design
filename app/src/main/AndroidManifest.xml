<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ 发通知需要运行时授权，见 MainActivity 里的申请逻辑与「我的」页降级提示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 在线词典（音标 / 双语例句）与单词发音音频都走 HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".WordMemoryApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordMemory">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知上的「10 分钟后 / 今天不提醒」由这个 Receiver 处理，不需要导出 -->
        <receiver
            android:name=".notification.ReminderActionReceiver"
            android:exported="false" />

        <!-- 只读统计出口：伴生模块（桌面小组件）通过它读「总词数 / 今日待复习」，不暴露表结构、不可写 -->
        <provider
            android:name=".data.WordStatsProvider"
            android:authorities="com.xucong.wordmemory.stats"
            android:exported="false"
            android:enabled="true" />

    </application>

</manifest>
